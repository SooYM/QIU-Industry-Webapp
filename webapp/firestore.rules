rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isGoogleSignIn() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }

    // Email + password, for company representatives whose employer runs its own
    // mail server and who therefore have no Google account.
    //
    // DELIBERATELY does NOT require email_verified. Firebase's verification mail
    // does not reach several providers used by these companies, which locked
    // every rep out. The gate is instead the admin approval that already exists:
    // registering grants NOTHING until an admin whitelists the address (see
    // isWhitelisted and approveSignup). The consequence, accepted knowingly: an
    // admin approving a request is the only thing proving that rep owns the
    // inbox, so they must recognise the company before approving.
    function isEmailPasswordSignIn() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'password';
    }

    function isAuthenticated() {
      return isGoogleSignIn() || isEmailPasswordSignIn();
    }

    // NOTE: students and staff are pinned to Google deliberately. If a qiu.edu.my
    // address could arrive through the password provider, anyone able to receive
    // mail at such an address would be indistinguishable from a real student —
    // so the QIU check requires Google specifically, not merely isAuthenticated().
    function isQiuUser() {
      return isGoogleSignIn()
        && request.auth.token.email is string
        && request.auth.token.email.matches('^[^@]+@qiu[.]edu[.]my$');
    }

    function isWhitelisted() {
      return isAuthenticated()
        && request.auth.token.email is string
        && exists(/databases/$(database)/documents/whitelisted_emails/$(request.auth.token.email.lower()))
        && (!('active' in get(/databases/$(database)/documents/whitelisted_emails/$(request.auth.token.email.lower())).data)
          || get(/databases/$(database)/documents/whitelisted_emails/$(request.auth.token.email.lower())).data.active == true);
    }

    function isAllowedUser() {
      return isQiuUser() || isWhitelisted();
    }

    /**
     * The role an admin has ALREADY granted this email on the whitelist.
     *
     * A first sign-in has to create its own users/{uid} document, and for an
     * approved employer that document carries role 'employer'. Without this the
     * create was denied and the app reported "Your account could not be checked",
     * locking out every rep the moment they were approved. Reading the admin's
     * own whitelist entry is not an escalation: a student is not on it, so this
     * resolves to 'user' for them.
     */
    function grantedRole() {
      return isAuthenticated()
        && request.auth.token.email is string
        && exists(/databases/$(database)/documents/whitelisted_emails/$(request.auth.token.email.lower()))
        ? get(/databases/$(database)/documents/whitelisted_emails/$(request.auth.token.email.lower())).data.get('role', 'user')
        : 'user';
    }

    // Google specifically, for the same reason as isQiuUser: the superadmin
    // address is a QIU one, and email-link sign-in must never be able to claim it.
    function isSuperAdmin() {
      return isGoogleSignIn() && request.auth.token.email == 'ai@qiu.edu.my';
    }

    function getUserRole() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : 'user';
    }

    function isAdmin() {
      return isAllowedUser() && (isSuperAdmin() || getUserRole() == 'admin');
    }

    function isEmployer() {
      return isAllowedUser() && getUserRole() == 'employer';
    }

    function validUser(data, uid) {
      return data.keys().hasAll(['email', 'role', 'updatedAt'])
        && data.keys().hasOnly(['email', 'displayName', 'photoURL', 'role', 'course', 'courseCode', 'employeeId', 'company', 'createdAt', 'updatedAt'])
        && data.email is string
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 120))
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 2048))
        && (!('course' in data) || (data.course is string && data.course.size() <= 120))
        && (!('courseCode' in data) || (data.courseCode is string && data.courseCode.size() <= 120))
        && (!('employeeId' in data) || (data.employeeId is string && data.employeeId.size() <= 120))
        && (!('company' in data) || (data.company is string && data.company.size() <= 160))
        && (!('createdAt' in data) || data.createdAt is timestamp)
        && data.updatedAt is timestamp
        && ((data.email == 'ai@qiu.edu.my' && data.role == 'superadmin' && isSuperAdmin() && uid == request.auth.uid)
          || (data.email != 'ai@qiu.edu.my' && data.role in ['user', 'admin', 'employer']));
    }

    function validVacancy(data) {
      return data.keys().hasAll([
          'id', 'title', 'company', 'type', 'specialization', 'vacancies', 'location',
          'salaryLabel', 'salary', 'payFrequency', 'minimumRequirement',
          'detailsLink', 'email', 'companySummary', 'companySources', 'isCustom',
          'locationMode', 'state', 'country', 'createdBy', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'title', 'company', 'type', 'specialization', 'vacancies', 'location',
          'salaryLabel', 'salary', 'payFrequency', 'minimumRequirement',
          'detailsLink', 'email', 'companySummary', 'companySources', 'isCustom',
          'locationMode', 'state', 'country', 'mapX', 'mapY', 'youtubeUrl', 'status',
          'pendingEdit', 'jobScope', 'requirement', 'createdBy', 'createdAt', 'updatedAt'
        ])
        && data.id is int && data.id > 0
        && data.title is string && data.title.size() > 0 && data.title.size() <= 160
        && data.company is string && data.company.size() > 0 && data.company.size() <= 160
        && data.type in ['Permanent', 'Internship', 'Contract', 'Part-time']
        && data.specialization is string && data.specialization.size() > 0 && data.specialization.size() <= 160
        && data.vacancies is int && data.vacancies >= 1 && data.vacancies <= 10000
        && data.location is string && data.location.size() > 0 && data.location.size() <= 160
        && data.salaryLabel is string && data.salaryLabel.size() <= 80
        && data.salary is number && data.salary > 0
        && data.payFrequency in ['Monthly', 'Annually', 'Weekly', 'Daily']
        && data.minimumRequirement in ['SPM', 'Certificate', 'Diploma', 'Degree', 'Post-graduate']
        && data.detailsLink is string && data.detailsLink.size() <= 2048
        && data.email is string && data.email.size() <= 254
        && (data.email == '' || data.email.matches('^[^@ ]+@[^@ ]+[.][^@ ]+$'))
        && data.companySummary is string && data.companySummary.size() <= 5000
        && data.companySources is list && data.companySources.size() <= 20
        && data.isCustom == true
        && data.locationMode in ['malaysia', 'international']
        && data.state is string && data.state.size() <= 80
        && data.country is string && data.country.size() <= 80
        && ((data.locationMode == 'malaysia' && data.state.size() > 0 && data.location == data.state)
          || (data.locationMode == 'international' && data.country.size() > 0 && data.location == data.country))
        && (!('mapX' in data) || (data.mapX is number && data.mapX >= 0 && data.mapX <= 1000))
        && (!('mapY' in data) || (data.mapY is number && data.mapY >= 0 && data.mapY <= 500))
        && (!('youtubeUrl' in data) || (data.youtubeUrl is string && data.youtubeUrl.size() <= 2048))
        && (!('jobScope' in data) || (data.jobScope is string && data.jobScope.size() <= 5000))
        && (!('requirement' in data) || (data.requirement is string && data.requirement.size() <= 5000))
        && (!('status' in data) || data.status in ['approved', 'pending', 'pending_edit', 'rejected'])
        && (!('pendingEdit' in data) || data.pendingEdit is map || data.pendingEdit == null)
        && data.createdBy is string && data.createdBy.size() > 0
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function validApplication(data) {
      return data.studentUid is string && data.studentUid.size() > 0
        && data.studentEmail is string && data.studentEmail.size() <= 254
        && data.studentName is string && data.studentName.size() <= 160
        && data.jobId is int && data.jobId > 0
        && data.jobTitle is string && data.jobTitle.size() <= 160
        && data.company is string && data.company.size() <= 160
        && (!('resumeId' in data) || (data.resumeId is string && data.resumeId.size() <= 256))
        && (!('resumeChoice' in data) || data.resumeChoice in ['generated', 'link']);
    }

    function validResume(data, uid) {
      return data.studentUid is string && data.studentUid == uid
        && data.studentEmail is string && data.studentEmail.size() <= 254
        && data.studentName is string && data.studentName.size() <= 160
        && data.source in ['upload', 'generated', 'link']
        && (!('fileUrl' in data) || (data.fileUrl is string && data.fileUrl.size() <= 2048))
        && (!('fileName' in data) || (data.fileName is string && data.fileName.size() <= 256))
        && (!('course' in data) || (data.course is string && data.course.size() <= 120))
        // Structured CV fields powering the generated CV; a bounded free-form map.
        && (!('profile' in data) || (data.profile is map && data.profile.size() <= 20));
    }

    function validCompany(data) {
      return data.keys().hasAll(['id', 'name', 'createdBy', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'name', 'email', 'website', 'logoUrl', 'videoUrl', 'summary', 'order', 'boothNumber', 'whatsapp', 'interestedIn', 'replyHours', 'logoBackground', 'status', 'pendingEdit', 'createdBy', 'createdAt', 'updatedAt'])
        && data.id is int && data.id > 0
        && data.name is string && data.name.size() > 0 && data.name.size() <= 200
        && (!('email' in data) || (data.email is string && data.email.size() > 3 && data.email.size() <= 254))
        && (!('website' in data) || (data.website is string && data.website.size() <= 2048))
        && (!('logoUrl' in data) || (data.logoUrl is string && data.logoUrl.size() <= 2048))
        && (!('videoUrl' in data) || (data.videoUrl is string && data.videoUrl.size() <= 2048))
        && (!('summary' in data) || (data.summary is string && data.summary.size() <= 5000))
        && (!('order' in data) || (data.order is number))
        && (!('boothNumber' in data) || (data.boothNumber is string && data.boothNumber.size() <= 40))
        && (!('whatsapp' in data) || (data.whatsapp is string && data.whatsapp.matches('^[0-9]{6,15}$')))
        && (!('interestedIn' in data) || (data.interestedIn is list && data.interestedIn.size() <= 30))
        && (!('replyHours' in data) || (data.replyHours is number && data.replyHours >= 0))
        && (!('logoBackground' in data) || data.logoBackground in ['auto', 'light', 'dark'])
        && (!('status' in data) || data.status in ['approved', 'pending', 'pending_edit'])
        && (!('pendingEdit' in data) || data.pendingEdit is map || data.pendingEdit == null)
        && data.createdBy is string
        && data.createdAt is timestamp && data.updatedAt is timestamp;
    }

    function validSettings(data) {
      return data.keys().hasOnly(['portalTitle', 'portalTagline', 'qrRotateSeconds', 'ccaPercent', 'ccaFloorMinutes', 'eventSpecializations', 'tabs', 'updatedAt'])
        && (!('portalTitle' in data) || (data.portalTitle is string && data.portalTitle.size() <= 120))
        && (!('portalTagline' in data) || (data.portalTagline is string && data.portalTagline.size() <= 200))
        && (!('qrRotateSeconds' in data) || (data.qrRotateSeconds is number && (data.qrRotateSeconds == 0 || (data.qrRotateSeconds >= 5 && data.qrRotateSeconds <= 600))))
        && (!('ccaPercent' in data) || (data.ccaPercent is number && data.ccaPercent >= 0 && data.ccaPercent <= 100))
        && (!('ccaFloorMinutes' in data) || (data.ccaFloorMinutes is number && data.ccaFloorMinutes >= 0 && data.ccaFloorMinutes <= 1440))
        && (!('eventSpecializations' in data) || (data.eventSpecializations is list && data.eventSpecializations.size() <= 50))
        && (!('tabs' in data) || (data.tabs is map && data.tabs.size() <= 10));
    }

    function validChatLog(data) {
      return data.studentUid is string && data.studentUid.size() > 0
        && data.studentEmail is string && data.studentEmail.size() <= 254
        && data.studentName is string && data.studentName.size() <= 160
        && data.question is string && data.question.size() <= 5000
        && data.answer is string && data.answer.size() <= 20000
        && (data.company == null || (data.company is string && data.company.size() <= 160));
    }

    function validEvent(data) {
      return data.keys().hasAll(['id', 'title', 'description', 'location', 'speakerName', 'speakerLinks', 'startAt', 'endAt', 'sessionMinutes', 'presenters', 'createdBy', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'title', 'description', 'location', 'speakerName', 'speakerLinks', 'speakerPhotoUrl', 'speakers', 'startAt', 'endAt', 'sessionMinutes', 'presenters', 'qrRotateSeconds', 'specialization', 'specializations', 'createdBy', 'createdAt', 'updatedAt'])
        && data.id is int && data.id > 0
        && data.title is string && data.title.size() > 0 && data.title.size() <= 200
        && data.description is string && data.description.size() <= 5000
        && data.location is string && data.location.size() <= 200
        && data.speakerName is string && data.speakerName.size() <= 200
        && data.speakerLinks is list && data.speakerLinks.size() <= 10
        && (!('speakerPhotoUrl' in data) || (data.speakerPhotoUrl is string && data.speakerPhotoUrl.size() <= 2048))
        && (!('speakers' in data) || (data.speakers is list && data.speakers.size() <= 20))
        && data.startAt is string && data.startAt.size() <= 40
        && data.endAt is string && data.endAt.size() <= 40
        && data.sessionMinutes is int && data.sessionMinutes >= 0 && data.sessionMinutes <= 1440
        && data.presenters is list && data.presenters.size() <= 50
        && (!('qrRotateSeconds' in data) || (data.qrRotateSeconds is number && (data.qrRotateSeconds == 0 || (data.qrRotateSeconds >= 5 && data.qrRotateSeconds <= 600))))
        && (!('specialization' in data) || (data.specialization is string && data.specialization.size() <= 160))
        && (!('specializations' in data) || (data.specializations is list && data.specializations.size() <= 20))
        && data.createdBy is string
        && data.createdAt is timestamp && data.updatedAt is timestamp;
    }

    // Live rotating code for an event (in event_codes/{eventId}). get() bypasses
    // read rules, so the attendance rules can validate the scanned code even though
    // students cannot read this collection.
    function eventCode(eventIdStr) {
      return get(/databases/$(database)/documents/event_codes/$(eventIdStr)).data;
    }

    match /users/{uid} {
      allow read: if isAllowedUser() && (request.auth.uid == uid || isSuperAdmin());
      allow create: if isAuthenticated()
        && validUser(request.resource.data, uid)
        && (isAdmin()
          || (uid == request.auth.uid
            && request.resource.data.role in ['user', 'superadmin', grantedRole()]));
      // A regular user may edit their own profile (displayName/photoURL/course/
      // updatedAt via merge) but may NOT change their own role. Admins & superadmin
      // may reassign roles; validUser still blocks minting a superadmin (only the
      // fixed ai@qiu.edu.my identity may hold that role).
      allow update: if isAllowedUser()
        && validUser(request.resource.data, uid)
        && (isAdmin() || request.resource.data.role == resource.data.role);
      allow delete: if isSuperAdmin() && resource.data.email != 'ai@qiu.edu.my';
    }

    match /whitelisted_emails/{emailId} {
      allow read: if isAuthenticated()
        && (emailId == request.auth.token.email.lower() || isAdmin());
      // Admins & superadmin can approve external accounts (and set the employer's company).
      allow write: if isAdmin();
    }

    match /vacancies/{vacancyId} {
      allow read: if isAllowedUser();
      // NOTE: the vacancy rules check isAllowedUser() ONCE and then compare roles
      // inline (isSuperAdmin/getUserRole) instead of routing through
      // isAdmin()/isEmployer()/canManageJobs(). Those wrappers re-expand the heavy
      // isAllowedUser() (regex + exists) on every call, and the create/update rules
      // reference role twice — the repeated expansion blew past Firestore's 1000
      // expression-evaluation limit. Inlining keeps each rule well under it.
      allow create: if isAllowedUser()
        && validVacancy(request.resource.data)
        && (request.resource.data.createdBy == request.auth.uid || request.resource.data.createdBy == request.auth.token.email.lower())
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        // Managers only. Employer listings are gated: they may only self-submit as
        // 'pending'. Admins/superadmin publish immediately ('approved') or queue.
        && (isSuperAdmin() || getUserRole() == 'admin'
          || (getUserRole() == 'employer' && request.resource.data.status == 'pending'));
      allow update: if isAllowedUser()
        && validVacancy(request.resource.data)
        // Ownership never transfers and creation time is fixed — immutable for
        // everyone, including admins. Reassigning createdBy would orphan an
        // employer from their own job.
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        // Admins/superadmin: any update incl. approve/reject. Employers: only their
        // own job, and may never set 'approved' (they stage 'pending_edit' instead).
        && (isSuperAdmin() || getUserRole() == 'admin'
          || (getUserRole() == 'employer'
            && (resource.data.createdBy == request.auth.uid || resource.data.createdBy == request.auth.token.email.lower())
            && (!('status' in request.resource.data) || request.resource.data.status != 'approved')));
      allow delete: if isAllowedUser()
        && (isSuperAdmin() || getUserRole() == 'admin'
          || (getUserRole() == 'employer' && (resource.data.createdBy == request.auth.uid || resource.data.createdBy == request.auth.token.email.lower())));
    }

    // A student's application history. Owner writes their own; employers/admins
    // read for candidate context.
    match /applications/{appId} {
      allow read: if isAllowedUser()
        && (resource.data.studentUid == request.auth.uid || isAdmin() || isEmployer());
      allow create, update: if isAllowedUser()
        && request.resource.data.studentUid == request.auth.uid
        && validApplication(request.resource.data);
      allow delete: if isAllowedUser()
        && (resource.data.studentUid == request.auth.uid || isAdmin());
    }

    // "Viewed job" events powering the student history tab. Private to the owner
    // (and admins for analytics).
    match /view_events/{id} {
      allow read: if isAllowedUser()
        && (resource.data.studentUid == request.auth.uid || isAdmin());
      allow create, update: if isAllowedUser()
        && request.resource.data.studentUid == request.auth.uid;
      allow delete: if isAllowedUser()
        && (resource.data.studentUid == request.auth.uid || isAdmin());
    }

    // One resume per student (doc id == student uid). Owner writes; employers and
    // admins read for hiring.
    match /resumes/{uid} {
      allow read: if isAllowedUser()
        && (request.auth.uid == uid || isAdmin() || isEmployer());
      allow create, update: if isAllowedUser()
        && request.auth.uid == uid
        && validResume(request.resource.data, uid);
      allow delete: if isAllowedUser()
        && (request.auth.uid == uid || isAdmin());
    }

    // Persisted assistant chat turns. Students append their own; admins read all.
    // POC boundary: employer per-company scoping and identity anonymization are
    // enforced CLIENT-SIDE via a where('company','==',...) query (see
    // subscribeCompanyChats). Rules do NOT map an employer -> company, so any
    // employer read is allowed here; do not treat this as a hard tenant boundary.
    match /chat_logs/{id} {
      allow read: if isAdmin() || isEmployer();
      allow create: if isAllowedUser()
        && request.resource.data.studentUid == request.auth.uid
        && validChatLog(request.resource.data);
      allow update: if false;
      allow delete: if isAdmin();
    }

    // Events: everyone allowed can read; only admins/superadmin manage.
    match /events/{eventId} {
      allow read: if isAllowedUser();
      allow create, update: if isAdmin() && validEvent(request.resource.data);
      allow delete: if isAdmin();
    }

    // Live rotating attendance code — managers write it; NO ONE reads it via the
    // client (get() in attendance rules still works). This is what defeats a
    // shared/screenshotted QR: the code rotates every ~25s.
    match /event_codes/{eventId} {
      allow read: if isAdmin();
      // Admins/superadmin, OR a person the admin assigned to present THIS event only.
      allow write: if isAdmin()
        || (isAllowedUser()
          && exists(/databases/$(database)/documents/events/$(eventId))
          && (request.auth.token.email.lower() in get(/databases/$(database)/documents/events/$(eventId)).data.presenters));
      allow delete: if isAdmin();
    }

    // Attendance: a student checks in / out only with the currently-valid code for
    // the active step; validated server-side against event_codes.
    match /attendance/{attendanceId} {
      allow read: if isAllowedUser() && (resource.data.studentUid == request.auth.uid || isAdmin());
      allow create: if isAllowedUser()
        && request.resource.data.studentUid == request.auth.uid
        && request.resource.data.step == 'checkin'
        && request.resource.data.eventId is int
        && request.resource.data.code is string
        && attendanceId == string(request.resource.data.eventId) + '_' + request.auth.uid
        && eventCode(string(request.resource.data.eventId)).activeStep == 'checkin'
        && ((eventCode(string(request.resource.data.eventId)).activeCode == request.resource.data.code
              && request.time.toMillis() < eventCode(string(request.resource.data.eventId)).codeExpiry)
          || (eventCode(string(request.resource.data.eventId)).previousCode == request.resource.data.code
              && request.time.toMillis() < eventCode(string(request.resource.data.eventId)).previousCodeExpiry));
      allow update: if isAllowedUser()
        && resource.data.studentUid == request.auth.uid
        && request.resource.data.studentUid == request.auth.uid
        && request.resource.data.step == 'checkout'
        && request.resource.data.code is string
        && eventCode(string(resource.data.eventId)).activeStep == 'checkout'
        && ((eventCode(string(resource.data.eventId)).activeCode == request.resource.data.code
              && request.time.toMillis() < eventCode(string(resource.data.eventId)).codeExpiry)
          || (eventCode(string(resource.data.eventId)).previousCode == request.resource.data.code
              && request.time.toMillis() < eventCode(string(resource.data.eventId)).previousCodeExpiry));
      allow delete: if isAdmin();
    }

    // Public per-job applicant tally (a single number, no identities). Any allowed
    // user can read it and increment it when they apply/withdraw.
    match /job_stats/{jobId} {
      allow read: if isAllowedUser();
      allow write: if isAllowedUser()
        && request.resource.data.keys().hasOnly(['applicants'])
        && request.resource.data.applicants is number;
      allow delete: if isAdmin();
    }

    // Exhibitor showcase on the Home landing. Everyone allowed reads; admins
    // manage any; an employer may submit/edit ONLY their own profile as 'pending'
    // (inline role checks — see the vacancy note on the 1000-expression limit).
    match /companies/{companyId} {
      allow read: if isAllowedUser();
      // Admins may create for anyone (e.g. approving a registration sets the
      // employer as createdBy); employers may only self-submit as 'pending'.
      allow create: if isAllowedUser()
        && validCompany(request.resource.data)
        && (isSuperAdmin() || getUserRole() == 'admin'
          || (getUserRole() == 'employer'
            && (request.resource.data.createdBy == request.auth.uid || request.resource.data.createdBy == request.auth.token.email.lower())
            && request.resource.data.status == 'pending'));
      allow update: if isAllowedUser()
        && validCompany(request.resource.data)
        && request.resource.data.createdBy == resource.data.createdBy
        && (isSuperAdmin() || getUserRole() == 'admin'
          || (getUserRole() == 'employer'
            && (resource.data.createdBy == request.auth.uid || resource.data.createdBy == request.auth.token.email.lower())
            && request.resource.data.status in ['pending', 'pending_edit']));
      allow delete: if isAdmin();
    }

    // Portal-wide settings (single doc). Everyone allowed reads so the UI can
    // apply title/tabs/attendance rules; only admins write.
    match /app_settings/{docId} {
      allow read: if isAllowedUser();
      allow write: if isAdmin() && validSettings(request.resource.data);
    }

    // Self-service employer registration. Any verified Google user may submit /
    // read / edit ONLY their own request (doc id = their email); admins review.
    // Approving it whitelists the email as an employer, so admins no longer add
    // external emails one by one.
    match /employer_signups/{emailId} {
      allow read: if isAuthenticated() && (emailId == request.auth.token.email.lower() || isAdmin());
      // The visitor creates/edits their own pending request…
      allow create: if isAuthenticated()
        && emailId == request.auth.token.email.lower()
        && request.resource.data.email == request.auth.token.email.lower()
        && request.resource.data.keys().hasOnly(['email', 'name', 'company', 'contact', 'website', 'logoUrl', 'videoUrl', 'summary', 'interestedIn', 'status', 'createdAt', 'updatedAt'])
        && (!('interestedIn' in request.resource.data) || (request.resource.data.interestedIn is list && request.resource.data.interestedIn.size() <= 30))
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 160
        && request.resource.data.company is string && request.resource.data.company.size() > 0 && request.resource.data.company.size() <= 200
        && (!('contact' in request.resource.data) || (request.resource.data.contact is string && request.resource.data.contact.size() <= 200))
        && (!('website' in request.resource.data) || (request.resource.data.website is string && request.resource.data.website.size() <= 2048))
        && (!('logoUrl' in request.resource.data) || (request.resource.data.logoUrl is string && request.resource.data.logoUrl.size() <= 2048))
        && (!('videoUrl' in request.resource.data) || (request.resource.data.videoUrl is string && request.resource.data.videoUrl.size() <= 2048))
        && (!('summary' in request.resource.data) || (request.resource.data.summary is string && request.resource.data.summary.size() <= 5000))
        && request.resource.data.status == 'pending';
      // …the owner may resubmit (stays pending); an admin may mark it approved.
      allow update: if isAdmin()
        || (isAuthenticated()
          && emailId == request.auth.token.email.lower()
          && request.resource.data.email == request.auth.token.email.lower()
          && request.resource.data.status == 'pending');
      allow delete: if isAdmin();
    }

    // Outbound approval-email queue consumed by Firebase Trigger Email. Only
    // trusted admins can enqueue bounded plain-text messages; clients cannot
    // alter delivery records after creation.
    match /mail/{mailId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['to', 'message', 'createdAt'])
        && request.resource.data.to is string
        && request.resource.data.to.size() <= 254
        && request.resource.data.to.matches('^[^@ ]+@[^@ ]+[.][^@ ]+$')
        && request.resource.data.message is map
        && request.resource.data.message.keys().hasOnly(['subject', 'text'])
        && request.resource.data.message.subject is string
        && request.resource.data.message.subject.size() <= 200
        && request.resource.data.message.text is string
        && request.resource.data.message.text.size() <= 5000
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    // "I'm interested in this talk". One doc per student per event; the doc id is
    // pinned so a student can only ever hold one, which keeps the counter honest.
    match /event_interests/{interestId} {
      allow read: if isAllowedUser();
      allow create: if isAllowedUser()
        && request.resource.data.studentUid == request.auth.uid
        && request.resource.data.eventId is int
        && interestId == string(request.resource.data.eventId) + '_' + request.auth.uid;
      allow update: if false;
      allow delete: if isAllowedUser() && resource.data.studentUid == request.auth.uid;
    }

    // Live Q&A open/closed switch — admins, or the presenter assigned to THIS event
    // (same trust model as event_codes). Students read it to know if the box is open.
    match /event_live_chat/{eventId} {
      allow read: if isAllowedUser();
      allow write: if isAdmin()
        || (isAllowedUser()
          && exists(/databases/$(database)/documents/events/$(eventId))
          && (request.auth.token.email.lower() in get(/databases/$(database)/documents/events/$(eventId)).data.presenters));
    }

    match /interview_slots/{slotId} {
      // Readable by every student — they must see whether a slot is full and
      // whether they hold it. That is exactly why `bookedStudents` carries uids
      // and nothing else: names, emails, courses and employee ids live in
      // /interview_bookings below, which students cannot read at all.
      allow read: if isAllowedUser();
      allow create, delete: if isAdmin() || isEmployer();
      // A student booking or cancelling may touch ONLY the booking list, may not
      // change the slot's capacity or time, and may only add or remove THEMSELF —
      // without the identity checks any student could delete another's booking.
      allow update: if isAdmin() || isEmployer()
        || (isAllowedUser()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['bookedStudents', 'updatedAt'])
          && request.resource.data.bookedStudents is list
          && (
            // Booking: exactly one entry appears, and it is the caller's own.
            (request.resource.data.bookedStudents.size() == resource.data.bookedStudents.size() + 1
              && request.resource.data.bookedStudents.size() <= resource.data.maxBookings
              && request.resource.data.bookedStudents.removeAll(resource.data.bookedStudents).size() == 1
              && request.resource.data.bookedStudents.removeAll(resource.data.bookedStudents)[0].studentUid == request.auth.uid)
            // Cancelling: exactly one entry disappears, and it is the caller's own.
            || (request.resource.data.bookedStudents.size() == resource.data.bookedStudents.size() - 1
              && resource.data.bookedStudents.removeAll(request.resource.data.bookedStudents).size() == 1
              && resource.data.bookedStudents.removeAll(request.resource.data.bookedStudents)[0].studentUid == request.auth.uid)
          ));
    }

    // The identity behind each seat. Staff-only: this is the collection that
    // keeps student contact details off the publicly-readable slot document.
    // Written in the same transaction as the seat, so the two cannot diverge.
    match /interview_bookings/{bookingId} {
      allow read: if isAdmin() || isEmployer();
      allow create: if isAllowedUser()
        && request.resource.data.studentUid == request.auth.uid
        && request.resource.data.slotId is string
        && bookingId == request.resource.data.slotId + '_' + request.auth.uid;
      allow update: if false;
      allow delete: if isAdmin() || isEmployer() || resource.data.studentUid == request.auth.uid;
    }

    // Questions asked during a talk. Accepted only while the facilitator has the
    // box open, so a closed session can't be written to by a crafted client.
    match /talk_live_chats/{chatId} {
      allow read: if isAllowedUser();
      allow create: if isAllowedUser()
        && request.resource.data.studentUid == request.auth.uid
        && request.resource.data.eventId is int
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 500
        && (request.resource.data.studentName == request.auth.token.email
          || ('name' in request.auth.token && request.resource.data.studentName == request.auth.token.name))
        && request.resource.data.approved == false
        && exists(/databases/$(database)/documents/event_live_chat/$(string(request.resource.data.eventId)))
        && get(/databases/$(database)/documents/event_live_chat/$(string(request.resource.data.eventId))).data.enabled == true
        // Only a student who checked in to this talk may ask — attendance doc exists.
        && exists(/databases/$(database)/documents/attendance/$(string(request.resource.data.eventId) + '_' + request.auth.uid));
      // Moderation: an admin or the talk's presenter may toggle `approved`, and
      // nothing else — the message text itself can never be edited after posting.
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['approved'])
        && request.resource.data.approved is bool
        && (isAdmin()
          || (isAllowedUser()
            && exists(/databases/$(database)/documents/events/$(string(resource.data.eventId)))
            && (request.auth.token.email.lower() in get(/databases/$(database)/documents/events/$(string(resource.data.eventId))).data.presenters)));
      allow delete: if isAdmin()
        || (isAllowedUser()
          && exists(/databases/$(database)/documents/events/$(string(resource.data.eventId)))
          && (request.auth.token.email.lower() in get(/databases/$(database)/documents/events/$(string(resource.data.eventId))).data.presenters));
    }

    // Post-talk reviews. Only students with an attendance record for that event —
    // "the student who attended can provide feedback".
    match /event_feedbacks/{feedbackId} {
      allow read: if isAllowedUser();
      allow create, update: if isAllowedUser()
        && request.resource.data.studentUid == request.auth.uid
        && request.resource.data.eventId is int
        && feedbackId == string(request.resource.data.eventId) + '_' + request.auth.uid
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
        && request.resource.data.comment is string
        && request.resource.data.comment.size() <= 2000
        && exists(/databases/$(database)/documents/attendance/$(string(request.resource.data.eventId) + '_' + request.auth.uid));
      allow delete: if isAdmin();
    }

    // One visit doc per student per company per browser session. The id is pinned and the
    // collection is create-only, so the dedupe is enforced here rather than by
    // the client — and the total is COUNTED from these docs. A counter field a
    // client increments directly can be pumped to any value from the console.
    match /company_views/{viewId} {
      allow read: if isAdmin() || isEmployer();
      allow create: if isAllowedUser()
        && request.resource.data.studentUid == request.auth.uid
        && request.resource.data.companyId is int
        && viewId.matches('^' + string(request.resource.data.companyId) + '_' + request.auth.uid + '_[a-z0-9]{12}$');
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
